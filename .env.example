# Server-side streaming platform API keys (NEVER expose to client/browser)
# Copy this file to .env.local for local development, or configure in Netlify Environment Variables.

# YouTube Data API v3 Key (https://console.cloud.google.com/apis/library/youtube.googleapis.com)
YOUTUBE_API_KEY=""

# Twitch Helix API Client Credentials (https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""

# Kick Public API Client Credentials (optional — fails gracefully if unavailable)
KICK_CLIENT_ID=""
KICK_CLIENT_SECRET=""

# Optional: AI Studio runtime URL
APP_URL="http://localhost:3000"
